{marker syn}
{title:Syntax}

{p 8 15 2}
{cmd:esta} [ {it:namelist} ] [ {cmd:using} {it:filename} ] [ {cmd:,}
{it:options} ]


    where {it:namelist}  is    {cmd:_all} | {cmd:*} | {it:name} [{it:name} ...]
          {it:name}      is    {it:identifier} | {cmd:.}


