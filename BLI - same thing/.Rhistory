# ===== Packages =====
library(tidyverse)
library(ggrepel)
library(scales)
# ===== Load your cleaned dataset =====
setwd("/Users/fangxiaoling/Documents/Nathan Nunn RA/Book/BLI - same thing")
bli_gdp <- read_csv("BLI_GDPpc.xlsx")  # rename to your actual file name
View(bli_gdp)
bli_gdp <- read_excel("BLI_GDPpc.xlsx")  # rename to your actual file name
bli_gdp <- read_excel("BLI_GDPpc.xlsx")
bli_gdp <- read_excel("BLI_GDPpc.xlsx")
library(tidyr)
bli_gdp <- read_excel("BLI_GDPpc.xlsx")
library(readxl)
bli_gdp <- read_excel("BLI_GDPpc.xlsx")
# ===== Linear model: GDPpc =====
m_lin <- lm(BLI ~ GDPpc_USD_2025, data = bli_gdp)
sum_lin <- summary(m_lin)
eq_lin <- sprintf("BLI = %.3f + %.6f × GDPpc  |  R² = %.3f, p = %.3g",
coef(m_lin)[1], coef(m_lin)[2], sum_lin$r.squared, coef(sum_lin)[2,4])
# ===== Linear model: log GDPpc =====
m_log <- lm(BLI ~ logG_2025, data = bli_gdp)
sum_log <- summary(m_log)
eq_log <- sprintf("BLI = %.3f + %.3f × log10(GDPpc)  |  R² = %.3f, p = %.3g",
coef(m_log)[1], coef(m_log)[2], sum_log$r.squared, coef(sum_log)[2,4])
# ===== Label countries (all, or choose top residuals for readability) =====
bli_gdp <- bli_gdp |>
mutate(resid_log = resid(m_log)) |>
arrange(desc(abs(resid_log))) |>
mutate(label_me = row_number() <= 20)   # change 20 → nrow(.) to label all
# ===== Plot 1: Linear GDP =====
p_lin <- ggplot(bli_gdp, aes(x = GDPpc_USD_2025, y = BLI)) +
geom_point(alpha = 0.7, size = 3) +
geom_smooth(method = "lm", se = TRUE, linewidth = 0.9) +
geom_text_repel(data = bli_gdp %>% filter(label_me),
aes(label = country),
size = 3.2, max.overlaps = Inf) +
scale_x_continuous(labels = label_dollar(prefix = "$"), breaks = pretty_breaks(n = 6)) +
labs(
title = "Better Life Index (equal-weight) vs GDP per capita, 2025",
subtitle = "Linear scale on GDP per capita",
x = "GDP per capita (USD, 2025)",
y = "BLI (0–10)",
caption = eq_lin
) +
theme_minimal(base_size = 13) +
theme(panel.grid.minor = element_blank(),
plot.caption = element_text(hjust = 0, face = "italic"))
ggsave("gdp_vs_bli_linear.png", p_lin, width = 11, height = 8.5, dpi = 300)
# ===== Plot 2: Log GDP =====
p_log <- ggplot(bli_gdp, aes(x = logG_2025, y = BLI)) +
geom_point(alpha = 0.7, size = 3) +
geom_smooth(method = "lm", se = TRUE, linewidth = 0.9) +
geom_text_repel(data = bli_gdp %>% filter(label_me),
aes(label = country),
size = 3.2, max.overlaps = Inf) +
labs(
title = "Better Life Index (equal-weight) vs GDP per capita, 2025",
subtitle = "Log scale on GDP per capita (base 10)",
x = "log10(GDP per capita, USD; 2025)",
y = "BLI (0–10)",
caption = eq_log
) +
theme_minimal(base_size = 13) +
theme(panel.grid.minor = element_blank(),
plot.caption = element_text(hjust = 0, face = "italic"))
ggsave("gdp_vs_bli_log.png", p_log, width = 11, height = 8.5, dpi = 300)
